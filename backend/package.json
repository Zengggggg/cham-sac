{
  "name": "chamsac-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "Twobars Party",
  "description": "Backend base project for Node.js, Express.js, and MongoDB applications.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "lint": "eslint src --ext js --report-unused-disable-directives --max-warnings 0",
    "dev": "node --watch ./src/server.js",
    "start": "node ./src/server.js",
    "production": "node ./src/server.js",
    "test": "node --test",
    "db:init": "node ./scripts/initDatabase.js",
    "db:migrate:is-verified:check": "node ./scripts/removeStoredIsVerified.js",
    "db:migrate:is-verified": "node ./scripts/removeStoredIsVerified.js --apply",
    "db:seed": "node ./scripts/seedDevelopment.js"
  },
  "dependencies": {
    "@payos/node": "^2.0.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "resend": "^6.32.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^8.47.0"
  }
}
